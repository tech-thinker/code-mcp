# MCP Reference Code Server - Environment Configuration
# Copy this file to .env and adjust values as needed
# 
# NOTE: Configuration is primarily loaded from config.json (mounted at /app/config/config.json).
# These environment variables are used as FALLBACKS when config.json is not present.

# =============================================================================
# Server Configuration (fallback)
# =============================================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_LOG_LEVEL=INFO

# =============================================================================
# Reference Projects Configuration (fallback - used if no config.json)
# =============================================================================
# Format: PROJECT_KEY=/absolute/path,PROJECT_KEY=/absolute/path
# Paths must be absolute and exist on the server filesystem
#
# Example for local development:
# REFERENCE_PROJECTS=frontend:/home/user/code-mcp/projects/frontend,backend:/home/user/code-mcp/projects/backend,shared:/home/user/code-mcp/projects/shared
#
# Example for Docker (container paths):
# REFERENCE_PROJECTS=frontend:/app/projects/frontend,backend:/app/projects/backend,shared:/app/projects/shared

REFERENCE_PROJECTS=

# =============================================================================
# File Access Configuration (fallback)
# =============================================================================
# Maximum file size to read (in bytes). Default: 1MB (1048576)
MCP_MAX_FILE_SIZE=1048576

# File encoding for reading text files. Default: utf-8
MCP_FILE_ENCODING=utf-8

# =============================================================================
# Directory Browsing Ignore Patterns (fallback)
# =============================================================================
# Comma-separated list of patterns to ignore when browsing directories
# Supports fnmatch patterns (*, ?, [seq], [!seq])

MCP_IGNORE_PATTERNS=node_modules,.venv,venv,.git,dist,build,__pycache__,.pytest_cache,.mypy_cache,.tox,*.pyc,*.pyo,*.pyd,.DS_Store,Thumbs.db,*.log,*.tmp,*.temp,.env,.env.local,.env.*.local

# =============================================================================
# Docker-Specific Notes
# =============================================================================
# When using docker-compose, the config.json is mounted to /app/config/config.json
# The projects are mounted to /app/projects/
# 
# Example docker-compose volumes:
#   volumes:
#     - ./projects/frontend:/app/projects/frontend:ro
#     - ./projects/backend:/app/projects/backend:ro
#     - ./projects/shared:/app/projects/shared:ro
#     - ./config.json:/app/config/config.json:ro
#
# Then config.json should use container paths:
# {
#   "projects": {
#     "frontend": { "path": "/app/projects/frontend" },
#     "backend":  { "path": "/app/projects/backend" },
#     "shared":   { "path": "/app/projects/shared" }
#   }
# }